# Copy to .env and fill in real values. Never commit .env.
# Read by the backend (pydantic-settings, backend/src/rag_hive/config.py) and by the Vite dev
# server (frontend/vite.config.ts). Every value below shows its default; empty means unset.

# --- Backend (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# JSON list. Only needed when the frontend is not served through the Vite proxy.
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=info

# --- LLM provider (agents) ---
# Local only, no API key (ADR-005). ollama
LLM_PROVIDER=ollama
# Pull it first: `ollama pull qwen3:8b`
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Embedding provider ---
# Local only, no API key (ADR-005). sentence-transformers (downloads the model on first use)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3

# --- Corpus (make corpus) ---
# Empty: data/corpus/manifest.yaml, data/corpus/raw/ and data/corpus/derived/ under the repo root.
CORPUS_MANIFEST_PATH=
CORPUS_RAW_DIR=
CORPUS_DERIVED_DIR=
CORPUS_DOWNLOAD_TIMEOUT_SECONDS=120
CORPUS_USER_AGENT="rag-hive-corpus/0.1 (+https://github.com/enzo-thuilliez/rag-hive)"

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
# Empty: same origin through the dev proxy. Set to the backend URL for a static build.
VITE_API_BASE_URL=
VITE_HEALTH_POLL_MS=10000
