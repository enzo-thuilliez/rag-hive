# Copy to .env and fill in real values. Never commit .env.
# Read by the backend (pydantic-settings, backend/src/rag_hive/config.py) and by the Vite dev
# server (frontend/vite.config.ts). Every value below shows its default; empty means unset.

# --- Backend (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# JSON list. Only needed when the frontend is not served through the Vite proxy.
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=info

# --- LLM provider (agents) ---
# anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embedding provider ---
# openai (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
# Empty: same origin through the dev proxy. Set to the backend URL for a static build.
VITE_API_BASE_URL=
VITE_HEALTH_POLL_MS=10000
